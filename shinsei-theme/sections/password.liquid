{% comment %}
  Shinsei Line Password Page Template

  Holding page: optional coat image, wordmark, year tag, three short
  fragments, and the early-access email field.
  The Shopify password form is hidden; staff reach it via the invisible
  top-left hotspot.

  Design tokens applied:
  - Background: #FAFAFA (primary background)
  - Logo: shinsei-logo.png
  - Responsive layout: 100vh viewport, centered

  Edited Oct 10, 2026: added optional coat image (section setting),
  three-line fragment copy, and "Request access" button label.
  Edited Oct 11, 2026: two centred columns (coat left; wordmark, copy and
  form right, each centred vertically); stacks on portrait phones and
  scales to fit any screen on load.
  Edited Oct 13, 2026: year tag reads LINE 01; copy cut to "Arriving soon.";
  Request access button bold, boxed, with a rectangular version of the
  homepage line-selector pulse ring.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes scan {
    0% { left: -100%; }
    50% { left: 100%; }
    100% { left: -100%; }
  }

  /* Same timing as the homepage line-selector pulse (lsPulse), but the box
     grows by a fixed distance so a wide button doesn't stretch out of shape */
  @keyframes boxPulse {
    0%   { inset: -1px;  opacity: 0.6; }
    100% { inset: -11px; opacity: 0; }
  }

  @keyframes pulse {
    0%, 100% { background: #2e2e2e; }
    50% { background: #5a5a5a; }
  }

  /* Reset and hide default Shopify password forms */
  html, body {
    background-color: #FAFAFA !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .shopify-challenge,
  .shopify-challenge__container,
  .shopify-challenge__button,
  .shopify-challenge__form {
    display: none !important;
  }

  /*
    Layout: two equal columns, centred as a pair. Left column holds the
    coat, centred vertically. Right column holds the wordmark, year tag,
    copy and signup form, centred vertically as a group. On portrait
    phones the columns stack (coat above, info below) and the coat scales
    to whatever height is left, so everything fits on load.
    Note: layout/password.liquid forces this wrapper to display:flex.
  */
  .password-page-wrapper {
    --gap: clamp(20px, 3.5vh, 36px);
    --col-gap: clamp(28px, 3.5vw, 64px);
    --stack-gap: clamp(12px, 2.2vh, 20px);
    --edge: clamp(16px, 4vh, 48px);
    --logo-h: clamp(44px, 7vh, 80px);

    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FAFAFA;
    overflow: hidden;
    box-sizing: border-box;
    padding:
      calc(var(--edge) + env(safe-area-inset-top, 0px))
      calc(24px + env(safe-area-inset-right, 0px))
      calc(var(--edge) + env(safe-area-inset-bottom, 0px))
      calc(24px + env(safe-area-inset-left, 0px));
  }

  .password-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    justify-items: center;
    width: 100%;
    max-width: 1080px;
    height: 100%;
    max-height: 100%;
  }

  /* Columns size to their content and sit together as a centred pair,
     so the gap between coat and info is exactly --col-gap. */
  .password-stage.has-image {
    grid-template-columns: auto auto;
    justify-content: center;
    column-gap: var(--col-gap);
  }

  .password-image {
    height: min(calc(100vh - 2 * var(--edge)), 860px);
    height: min(calc(100svh - 2 * var(--edge) - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)), 860px);
    max-width: 46vw;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 0.1s;
    opacity: 0;
  }

  .password-image img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .password-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--stack-gap);
  }

  .password-wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: calc(var(--gap) - var(--stack-gap));
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 0.4s;
    opacity: 0;
  }

  .password-wordmark img {
    display: block;
    width: auto;
    height: var(--logo-h);
    max-width: 60vw;
    object-fit: contain;
  }

  .year-tag {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 1.4s;
    opacity: 0;
  }

  .year-tag-rule {
    width: 40px;
    height: 2px;
    background-color: #2a2a2a;
    position: relative;
    overflow: hidden;
  }

  .year-tag-rule::after {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 2px;
    background: #5a5a5a;
    animation: scan 3.2s ease-in-out infinite;
    animation-delay: 2.4s;
    content: '';
  }

  .dot-group {
    display: flex;
    flex-direction: row;
    gap: 5px;
    align-items: center;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #2e2e2e;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .dot:nth-child(1) { animation-delay: 2.6s; }
  .dot:nth-child(2) { animation-delay: 2.9s; }
  .dot:nth-child(3) { animation-delay: 3.2s; }

  .year-text {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    line-height: 1;
  }

  .password-fragments {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 1.7s;
    opacity: 0;
  }

  .password-fragments p {
    margin: 0;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
  }

  .password-signup {
    text-align: center;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 2s;
    opacity: 0;
  }

  .password-signup-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 0;
  }

  .password-signup-form[hidden] {
    display: none;
  }

  .password-signup-form input[type="email"] {
    width: 200px;
    max-width: calc(100vw - 64px);
    border: none;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0;
    background: transparent;
    outline: none;
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
    -webkit-appearance: none;
    appearance: none;
  }

  .password-signup-form input[type="email"]::placeholder {
    color: #3a3a3a;
  }

  .password-signup-form input[type="email"]:focus {
    border-color: #3a3a3a;
  }

  .password-signup-form button {
    position: relative;
    border: 1px solid #0D0D0D;
    border-radius: 0;
    background: none;
    padding: 9px 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0D0D0D;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    cursor: pointer;
  }

  /* Rectangular version of the homepage line-selector pulse ring */
  .password-signup-form button::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid #0D0D0D;
    animation: boxPulse 2.2s ease-out infinite;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .password-signup-form button::after { animation: none; opacity: 0; }
  }

  .password-signup-message {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
    text-align: center;
  }

  /* Phones */
  @media (max-width: 480px) {
    .year-tag { gap: 8px; }
    .year-tag-rule { width: 24px; }
    .dot { width: 3px; height: 3px; }
    .year-text { font-size: 10px; }
    .password-fragments p { font-size: 10px; letter-spacing: 0.18em; }
    .password-signup-form input[type="email"] { width: 180px; }
    .secret-password-inner input[type="password"] {
      width: 100%;
      max-width: calc(100vw - 96px);
    }
  }

  /* Portrait phones and narrow tablets: stack in one column in this
     order: wordmark, coat, then year tag, copy and form. The info block
     is flattened (display: contents) so the coat can sit between the
     wordmark and the rest. The coat takes the height that is left. */
  @media (max-width: 1024px) and (orientation: portrait) {
    .password-page-wrapper {
      --logo-h: clamp(40px, 6.5vh, 64px);
    }
    .password-stage.has-image {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--stack-gap);
    }
    .password-stage.has-image .password-info {
      display: contents;
    }
    .password-stage.has-image .password-wordmark {
      order: 1;
      flex: 0 0 auto;
      margin-bottom: calc(var(--gap) - var(--stack-gap));
    }
    .password-stage.has-image .password-image {
      order: 2;
      flex: 0 1 auto;
      max-width: 100%;
      height: 48vh;
      height: 48svh;
      min-height: 0;
      margin-bottom: calc(var(--gap) - var(--stack-gap));
    }
    .password-stage.has-image .year-tag,
    .password-stage.has-image .password-fragments,
    .password-stage.has-image .password-signup {
      order: 3;
      flex: 0 0 auto;
    }
  }

  /* Short screens */
  @media (max-height: 700px) {
    .password-page-wrapper { --stack-gap: 12px; }
    .password-fragments { gap: 6px; }
    .password-signup-form { gap: 10px; }
  }

  /* Very short screens (phones in landscape) */
  @media (max-height: 520px) {
    .password-page-wrapper {
      --gap: 14px;
      --stack-gap: 10px;
      --edge: 12px;
      --logo-h: 36px;
      --col-gap: 24px;
    }
    .password-fragments p { font-size: 10px; }
    .year-text { font-size: 10px; }
  }

  /* Portrait but very short (rare): drop the coat so the essentials fit */
  @media (max-height: 420px) and (orientation: portrait) {
    .password-image { display: none; }
  }

  /* Secret staff-access hotspot — invisible, top-left, no hover/focus affordance */
  .secret-access-btn {
    position: fixed;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    z-index: 100000;
  }

  .secret-password-form {
    display: none;
    position: fixed;
    inset: 0;
    align-items: center;
    justify-content: center;
    background-color: #FAFAFA;
    z-index: 100001;
  }

  .secret-password-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .secret-password-inner input[type="password"] {
    width: 220px;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0;
    background: transparent;
    outline: none;
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
  }

  .secret-password-inner input[type="password"]::placeholder {
    color: #3a3a3a;
  }

  .secret-password-inner input[type="password"]:focus {
    border-color: #3a3a3a;
  }

  .secret-password-inner button {
    border: none;
    background: none;
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    cursor: pointer;
    border-bottom: 1px solid #2a2a2a;
  }

  .secret-password-error {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #a33;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
  }
</style>

{%- assign password_attempt_failed = false -%}
{%- capture secret_password_form_html -%}
  {%- form 'storefront_password', class: 'secret-password-inner' -%}
    <input type="password" name="password" placeholder="Store password" autocomplete="off" required>
    <button type="submit">Enter</button>
    {%- if form.errors -%}
      <p class="secret-password-error">Incorrect password.</p>
      {%- assign password_attempt_failed = true -%}
    {%- endif -%}
  {%- endform -%}
{%- endcapture -%}

<button
  type="button"
  class="secret-access-btn"
  aria-hidden="true"
  tabindex="-1"
  onclick="document.getElementById('secret-password-form').style.display='flex'; document.getElementById('password-page-wrapper').style.display='none';"
></button>

<div class="secret-password-form" id="secret-password-form"{% if password_attempt_failed %} style="display:flex;"{% endif %}>
  {{ secret_password_form_html }}
</div>

<div class="password-page-wrapper" id="password-page-wrapper"{% if password_attempt_failed %} style="display:none;"{% endif %}>
  <div class="password-stage{% if section.settings.coat_image != blank %} has-image{% endif %}">
    {%- if section.settings.coat_image != blank -%}
      <div class="password-image">
        {{
          section.settings.coat_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(max-width: 1024px) and (orientation: portrait) 80vw, 45vw',
            widths: '400, 600, 800, 1000, 1200',
            alt: section.settings.coat_image.alt
        }}
      </div>
    {%- endif -%}

    <div class="password-info">
      <div class="password-wordmark">
        <img
          src="{{ 'shinsei-logo.png' | asset_url }}"
          alt="Shinsei Line"
          height="64"
        >
      </div>

      <div class="year-tag">
        <div class="year-tag-rule"></div>
        <div class="dot-group">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
        <div class="year-text">LINE 01</div>
        <div class="dot-group">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
        <div class="year-tag-rule"></div>
      </div>

      {%- if section.settings.line_1 != blank or section.settings.line_2 != blank or section.settings.line_3 != blank -%}
        <div class="password-fragments">
          {%- if section.settings.line_1 != blank -%}<p>{{ section.settings.line_1 | escape }}</p>{%- endif -%}
          {%- if section.settings.line_2 != blank -%}<p>{{ section.settings.line_2 | escape }}</p>{%- endif -%}
          {%- if section.settings.line_3 != blank -%}<p>{{ section.settings.line_3 | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="password-signup">
        {%- form 'customer', id: 'PasswordSignupForm', class: 'password-signup-form' -%}
          <input type="hidden" name="contact[tags]" value="holding-page">
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- if form.posted_successfully? -%}
            <p class="password-signup-message">You're on the list.</p>
          {%- else -%}
            <input type="email" name="contact[email]" id="PasswordSignupForm-email" placeholder="Email address" autocomplete="email" aria-label="Email address" required>
            <button type="submit">{{ section.settings.button_label | default: 'Request access' | escape }}</button>
            {%- if form.errors -%}
              <p class="password-signup-message">{{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('PasswordSignupForm');
    if (!form) return;
    var confirmedKey = 'shinseiSignupConfirmed';
    var showConfirmation = function () {
      if (form.querySelector('.password-signup-message')) return;
      form.hidden = true;
      var message = document.createElement('p');
      message.className = 'password-signup-message';
      message.textContent = "You're on the list.";
      form.parentNode.insertBefore(message, form);
    };
    try {
      if (sessionStorage.getItem(confirmedKey)) {
        sessionStorage.removeItem(confirmedKey);
        showConfirmation();
      }
    } catch (e) {}
    form.addEventListener('submit', function () {
      var email = form.querySelector('input[name="contact[email]"]');
      if (!email || !email.value) return;
      try { sessionStorage.setItem(confirmedKey, '1'); } catch (e) {}
      showConfirmation();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "coat_image",
      "label": "Coat image",
      "info": "Optional. One frame of the coat with plenty of negative space. Leave empty to show the wordmark only."
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Line 1"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Line 2"
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Line 3",
      "default": "Arriving soon."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request access"
    }
  ]
}
{% endschema %}
