{% comment %}
  Shinsei Line Password Page Template
  
  A brand-focused holding page with only the wordmark displayed.
  The Shopify password form is hidden (display: none) since this serves
  as a pure holding page.
  
  Design tokens applied:
  - Background: #FAFAFA (primary background)
  - Logo: shinsei-logo.png
  - Responsive layout: 100vh viewport, centered
  
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scan {
    0% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
    100% {
      left: -100%;
    }
  }

  @keyframes pulse {
    0%, 100% {
      background: #2e2e2e;
    }
    50% {
      background: #5a5a5a;
    }
  }

  /* Reset and hide default Shopify password forms */
  html, body {
    background-color: #FAFAFA !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide Shopify password challenge container */
  .shopify-challenge,
  .shopify-challenge__container,
  .shopify-challenge__button,
  .shopify-challenge__form {
    display: none !important;
  }

  .password-page-wrapper {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FAFAFA;
    z-index: 99999;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .password-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .password-wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 0.4s;
    opacity: 0;
  }

  .password-wordmark img {
    width: auto;
    height: 64px;
    display: block;
  }



  .year-tag {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 1.4s;
    opacity: 0;
  }

  .year-tag-rule {
    width: 40px;
    height: 2px;
    background-color: #2a2a2a;
    position: relative;
    overflow: hidden;
  }

  .year-tag-rule::after {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 2px;
    background: #5a5a5a;
    animation: scan 3.2s ease-in-out infinite;
    animation-delay: 2.4s;
    content: '';
  }

  .dot-group {
    display: flex;
    flex-direction: row;
    gap: 5px;
    align-items: center;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #2e2e2e;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .dot:nth-child(1) {
    animation-delay: 2.6s;
  }

  .dot:nth-child(2) {
    animation-delay: 2.9s;
  }

  .dot:nth-child(3) {
    animation-delay: 3.2s;
  }

  .year-text {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    line-height: 1;
  }

  .password-signup {
    animation: fadeIn 1.8s ease forwards;
    animation-delay: 2s;
    opacity: 0;
  }

  .password-signup-form {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .password-signup-form input[type="email"] {
    width: 200px;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    background: transparent;
    outline: none;
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
  }

  .password-signup-form input[type="email"]::placeholder {
    color: #3a3a3a;
  }

  .password-signup-form input[type="email"]:focus {
    border-color: #3a3a3a;
  }

  .password-signup-form button {
    border: none;
    background: none;
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    cursor: pointer;
    border-bottom: 1px solid #2a2a2a;
  }

  .password-signup-message {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
  }

  @media (max-width: 640px) {
    .password-wordmark img {
      height: 48px;
    }
    .year-tag-rule {
      width: 32px;
    }
    .year-text {
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .password-wordmark img {
      height: 40px;
    }
    .year-tag {
      gap: 8px;
    }
    .year-tag-rule {
      width: 24px;
    }
    .dot {
      width: 3px;
      height: 3px;
    }
    .year-text {
      font-size: 10px;
    }
    .password-signup-form {
      flex-wrap: wrap;
      justify-content: center;
      max-width: calc(100vw - 48px);
    }
    .password-signup-form input[type="email"] {
      width: 160px;
    }
    .secret-password-inner input[type="password"] {
      width: 100%;
      max-width: calc(100vw - 96px);
    }
  }

  {% comment %} Hide the default Shopify password form {% endcomment %}
  .shopify-challenge__container {
    display: none !important;
  }

  /* Secret staff-access hotspot — invisible, top-left, no hover/focus affordance */
  .secret-access-btn {
    position: fixed;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    z-index: 100000;
  }

  .secret-password-form {
    display: none;
    position: fixed;
    inset: 0;
    align-items: center;
    justify-content: center;
    background-color: #FAFAFA;
    z-index: 100001;
  }

  .secret-password-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .secret-password-inner input[type="password"] {
    width: 220px;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    background: transparent;
    outline: none;
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
  }

  .secret-password-inner input[type="password"]::placeholder {
    color: #3a3a3a;
  }

  .secret-password-inner input[type="password"]:focus {
    border-color: #3a3a3a;
  }

  .secret-password-inner button {
    border: none;
    background: none;
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3a3a;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    cursor: pointer;
    border-bottom: 1px solid #2a2a2a;
  }

  .secret-password-error {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #a33;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
  }
</style>

{%- assign password_attempt_failed = false -%}
{%- capture secret_password_form_html -%}
  {%- form 'storefront_password', class: 'secret-password-inner' -%}
    <input type="password" name="password" placeholder="Store password" autocomplete="off" required>
    <button type="submit">Enter</button>
    {%- if form.errors -%}
      <p class="secret-password-error">Incorrect password.</p>
      {%- assign password_attempt_failed = true -%}
    {%- endif -%}
  {%- endform -%}
{%- endcapture -%}

<button
  type="button"
  class="secret-access-btn"
  aria-hidden="true"
  tabindex="-1"
  onclick="document.getElementById('secret-password-form').style.display='flex'; document.getElementById('password-page-wrapper').style.display='none';"
></button>

<div class="secret-password-form" id="secret-password-form"{% if password_attempt_failed %} style="display:flex;"{% endif %}>
  {{ secret_password_form_html }}
</div>

<div class="password-page-wrapper" id="password-page-wrapper"{% if password_attempt_failed %} style="display:none;"{% endif %}>
  <div class="password-content">
    <div class="password-wordmark">
      <img 
        src="{{ 'shinsei-logo.png' | asset_url }}" 
        alt="Shinsei Line" 
        width="auto" 
        height="64"
      >
    </div>

    <div class="year-tag">
      <div class="year-tag-rule"></div>
      <div class="dot-group">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
      <div class="year-text">2026</div>
      <div class="dot-group">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
      <div class="year-tag-rule"></div>
    </div>

    <div class="password-signup">
      {%- form 'customer', id: 'PasswordSignupForm', class: 'password-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="holding-page">
        <input type="hidden" name="return_to" value="{{ request.path }}">
        {%- if form.posted_successfully? -%}
          <p class="password-signup-message">You're on the list.</p>
        {%- else -%}
          <input type="email" name="contact[email]" id="PasswordSignupForm-email" placeholder="Email address" autocomplete="email" required>
          <button type="submit">Notify Me</button>
          {%- if form.errors -%}
            <p class="password-signup-message">{{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
