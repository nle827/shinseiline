{%- liquid
  assign show_request_access = false
  assign show_soldout = false
  unless product.available
    if product.tags contains 'coming-soon'
      assign show_request_access = true
    else
      assign show_soldout = true
    endif
  endunless

  assign drop_coming_soon = false
  if product.tags contains 'coming-soon'
    assign drop_coming_soon = true
  endif
-%}

<script type="application/json" id="drop-phase-data">{"earlyAccessStart": {{ settings.drop_early_access_start | json }}, "publicOpen": {{ settings.drop_public_open | json }}, "closeAt": {{ settings.drop_close | json }}, "passcodeHash": {{ settings.drop_passcode_hash | json }}, "phaseOverride": {{ settings.drop_phase_override | json }}, "available": {{ product.available | json }}, "comingSoon": {{ drop_coming_soon | json }}}</script>

<section class="pdp-layout">

  <!-- LEFT: specifications (desktop; on mobile the same content shows in
       the Product specifications accordion instead). Both read the
       product's nl_modules.specs metafield. -->
  <div class="pdp-construction">
    <div class="pdp-construction-inner">
      {% content_for 'block', type: 'nl-spec-list', id: 'specs-column' %}
    </div>
  </div>

  <!-- MIDDLE: image stack -->
  <div class="pdp-gallery-track">
    {%- for image in product.images -%}
      <div class="pdp-stack-img">
        <img
          src="{{ image | image_url: width: 900 }}"
          srcset="
            {{- image | image_url: width: 400 }} 400w,
            {{ image | image_url: width: 600 }} 600w,
            {{ image | image_url: width: 900 }} 900w,
            {{ image | image_url: width: 1200 }} 1200w,
            {{ image | image_url: width: 1800 }} 1800w
          "
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="{{ image.alt | default: product.title }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          draggable="false"
          {% unless forloop.first %}loading="lazy"{% endunless %}
        >
      </div>
    {%- else -%}
      <div class="pdp-stack-img pdp-stack-img--placeholder"></div>
    {%- endfor -%}
  </div>

  {%- if product.images.size > 1 -%}
    <!-- Mobile only: position counter for the swipe row -->
    <div class="pdp-gallery-count" id="pdp-gallery-count" aria-hidden="true">
      <span id="pdp-gallery-current">01</span> / {{ product.images.size | prepend: '0' | slice: -2, 2 }}
    </div>
  {%- endif -%}

  <!-- RIGHT: product info -->
  <div class="pdp-info">
    <div class="pdp-info-inner">

      <div class="pdp-info-top">
        <span class="pdp-label">Shinsei Line — No. 001</span>
        <h1 class="pdp-title">{{ product.title }}</h1>
        <p class="pdp-price">{{ product.price | money }}</p>
      </div>

      <!-- Variants (hidden until JS resolves the drop phase — avoids a flash
           of the wrong UI for early/closed states; see drop-phase-data) -->
      <div class="pdp-variants" id="pdp-variants" style="display:none;">
        <div class="pdp-variant-group">
          <span class="pdp-variant-label">Size</span>
          <div class="pdp-variant-options">
            {%- for variant in product.variants -%}
              <button
                class="pdp-variant-btn{% unless variant.available %} pdp-variant-btn--oos{% endunless %}"
                data-variant-id="{{ variant.id }}"
                data-variant-title="{{ variant.title }}"
                data-inventory="{{ variant.inventory_quantity }}"
                data-inventory-management="{{ variant.inventory_management }}"
                data-inventory-policy="{{ variant.inventory_policy }}"
                onclick="selectVariant(this, 'size')"
                {% unless variant.available %}disabled{% endunless %}
              >{{ variant.title }}</button>
            {%- endfor -%}
          </div>
        </div>

        <div class="pdp-variant-group">
          <span class="pdp-variant-label">Quantity</span>
          <div class="pdp-quantity-stepper">
            <button type="button" class="pdp-quantity-btn" onclick="changeQuantity(-1)" aria-label="Decrease quantity">−</button>
            <input type="number" class="pdp-quantity-input" id="pdp-quantity-input" value="1" min="1" max="99" inputmode="numeric" onchange="clampQuantityInput()">
            <button type="button" class="pdp-quantity-btn" onclick="changeQuantity(1)" aria-label="Increase quantity">+</button>
          </div>
        </div>
      </div>

      <!-- Add to cart (normal available product) — hidden until JS resolves
           the drop phase (public, or early + already unlocked) -->
      <div class="pdp-actions" id="pdp-actions-available" style="display:none;">
        <button class="pdp-add-to-cart" onclick="addToCart()">ADD TO CART</button>
      </div>

      <!-- Passcode gate (early access, not yet unlocked on this device) -->
      <div class="pdp-actions pdp-request-access" id="pdp-actions-passcode" style="display:none;">
        <p class="pdp-unavailable-label">First access.</p>
        <form class="pdp-access-form" id="PasscodeForm" onsubmit="return submitDropPasscode(event)">
          <div class="pdp-access-fields">
            <input type="password" id="pdp-passcode-input" placeholder="Passcode" autocomplete="off" required>
          </div>
          <button type="submit" class="pdp-add-to-cart">ENTER</button>
        </form>
        <p class="pdp-access-note" id="pdp-passcode-error" style="display:none;">Not recognized.</p>
        <p class="pdp-access-note pdp-access-secondary">Not on the list? <a href="javascript:void(0)" onclick="openRequestModal()">Request access</a></p>
      </div>

      <!-- Request Access (unavailable) -->
      <div class="pdp-actions pdp-request-access" id="pdp-actions-unavailable" {% unless show_request_access %}style="display:none;"{% endunless %}>
        <p class="pdp-unavailable-label">Not yet available</p>
        <button type="button" class="pdp-add-to-cart" onclick="openRequestModal()">REQUEST ACCESS</button>
      </div>

      {%- liquid
        assign request_success = false
        assign request_error = false
      -%}
      {%- capture request_modal_form -%}
        {%- form 'customer', id: 'RequestAccessForm', class: 'notify-modal-form' -%}
          <input type="hidden" name="contact[tags]" value="request-access">
          <input type="hidden" name="return_to" value="{{ request.path }}?requested=1">
          {%- if form.posted_successfully? -%}
            {%- assign request_success = true -%}
          {%- else -%}
            <input type="email" name="contact[email]" id="RequestAccessForm-email" placeholder="Email address" autocomplete="email" required>
            <button type="submit">Request Access</button>
            {%- if form.errors -%}
              {%- assign request_error = true -%}
              <p class="notify-modal-error">{{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- endcapture -%}

      <script type="application/json" id="request-status-data">{"success": {{ request_success | json }}, "error": {{ request_error | json }}}</script>

      <div class="notify-modal-overlay{% if request_error or request_success %} open{% endif %}" id="request-modal-overlay">
        <div class="notify-modal" id="request-modal">
          <button type="button" class="notify-modal-close" onclick="closeRequestModal()" aria-label="Close">×</button>
          <div class="notify-modal-content" id="request-modal-content"{% if request_success %} style="display:none;"{% endif %}>
            <p class="notify-modal-label">Request access</p>
            {{ request_modal_form }}
            <div class="notify-loading" id="request-loading">
              <div class="notify-loading-track">
                <span class="notify-loading-dot notify-loading-dot--start"></span>
                <div class="notify-loading-fill"></div>
                <span class="notify-loading-dot notify-loading-dot--end"></span>
              </div>
              <span class="notify-loading-label">Sending</span>
            </div>
          </div>
          <div class="notify-modal-success" id="request-modal-success"{% unless request_success %} style="display:none;"{% endunless %}>
            <p class="notify-modal-success-msg">Request received.</p>
            <p class="notify-modal-success-note">You'll be among the first to know.</p>
          </div>
        </div>
      </div>

      <!-- Departed: sold through (unavailable, no coming-soon tag) is
           server-rendered immediately; closed-while-still-available is
           revealed by JS once it resolves the drop phase. No restock
           language — LINE 01 does not restock. -->
      <div class="pdp-actions pdp-request-access" id="pdp-actions-departed" {% unless show_soldout %}style="display:none;"{% endunless %}>
        <p class="pdp-unavailable-label">Departed.</p>
        <p class="pdp-access-note">LINE 01 has closed.</p>
      </div>

      <!-- Accordions -->
      <div class="pdp-accordions">
        <!-- Mobile only: the left specifications column moves in here -->
        {% content_for 'block', type: 'nl-spec-list', id: 'specs-accordion' %}
        <div class="accordion">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            <span>Sizing</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-body">
            <div class="size-chart-wrap">
              <div class="size-chart-unit-toggle" role="group" aria-label="Sizing units">
                <button type="button" class="unit-toggle-btn unit-toggle-btn--active" onclick="setSizeChartUnit(this, 'in')" aria-pressed="true">IN</button>
                <span class="unit-toggle-sep">/</span>
                <button type="button" class="unit-toggle-btn" onclick="setSizeChartUnit(this, 'cm')" aria-pressed="false">CM</button>
              </div>
              <table class="size-chart">
                <thead>
                  <tr><th></th><th>S</th><th>M</th><th>L</th><th>XL</th></tr>
                </thead>
                <tbody>
                  <tr><td class="size-chart-dim">Chest</td><td data-in="22 in" data-cm="56 cm">22 in</td><td data-in="23 in" data-cm="58 cm">23 in</td><td data-in="24 in" data-cm="61 cm">24 in</td><td data-in="25 in" data-cm="64 cm">25 in</td></tr>
                  <tr><td class="size-chart-dim">Shoulder</td><td data-in="19.5 in" data-cm="50 cm">19.5 in</td><td data-in="20 in" data-cm="51 cm">20 in</td><td data-in="20.5 in" data-cm="52 cm">20.5 in</td><td data-in="21 in" data-cm="53 cm">21 in</td></tr>
                  <tr><td class="size-chart-dim">Length</td><td data-in="47 in" data-cm="119 cm">47 in</td><td data-in="48 in" data-cm="122 cm">48 in</td><td data-in="49 in" data-cm="124 cm">49 in</td><td data-in="50 in" data-cm="127 cm">50 in</td></tr>
                  <tr><td class="size-chart-dim">Sleeve</td><td data-in="23.5 in" data-cm="60 cm">23.5 in</td><td data-in="24 in" data-cm="61 cm">24 in</td><td data-in="24.5 in" data-cm="62 cm">24.5 in</td><td data-in="25 in" data-cm="64 cm">25 in</td></tr>
                </tbody>
              </table>
              <p class="size-chart-note">Unisex. Cut with room to layer. Women may prefer one size down. Measurements may vary ±1 cm.</p>
            </div>
          </div>
        </div>
        <div class="accordion">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            <span>Info</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-body">
            <p>LINE 01 is made to order. Production begins when the preorder window closes; expect delivery about 6–7 weeks later.</p>
            <p>Returns accepted within 14 days of delivery, unworn and unaltered. Exchanges are our preference.</p>
            <p>Currently shipping to the United States, Canada, United Kingdom, France, Germany, Australia, Japan, and South Korea. More markets coming soon.</p>
            <p>International orders are responsible for duties, customs fees, and local taxes collected at delivery.</p>
            <p><a href="/pages/policy">Full shipping and returns terms</a></p>
          </div>
        </div>
      </div>

      {%- comment -%} Extra blocks added in the theme editor {%- endcomment -%}
      {% content_for 'blocks' %}

      <a href="/pages/policy" class="pdp-policy-link">Policies →</a>

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Product",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
