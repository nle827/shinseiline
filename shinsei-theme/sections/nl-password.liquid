{% comment %}
  nl-password: holding page for a password-protected store.

  Optional image, logo, a tag line with transit-style rules and dots
  ("LINE 01"), up to three short lines of copy, and an email signup with a
  pulsing button. The Shopify staff password form is hidden behind an
  invisible hotspot in the top-left corner.

  Every piece of copy, the customer tag and the colours are section
  settings. Styles: assets/nl-password.css. Behaviour: assets/nl-password.js
  (custom element <nl-password>).
{% endcomment %}

{%- liquid
  assign staff_failed = false
  assign classes = 'nl-password'
  if section.settings.pulse
    assign classes = classes | append: ' nl-password--pulse'
  endif
-%}

{%- capture staff_form -%}
  {%- form 'storefront_password', class: 'nl-password__staff-form' -%}
    <input
      type="password"
      name="password"
      placeholder="{{ section.settings.staff_placeholder | escape }}"
      aria-label="{{ section.settings.staff_placeholder | escape }}"
      autocomplete="off"
      required
    >
    <button type="submit">{{ section.settings.staff_button | escape }}</button>
    {%- if form.errors -%}
      <p class="nl-password__staff-error">{{ section.settings.staff_error | escape }}</p>
      {%- assign staff_failed = true -%}
    {%- endif -%}
  {%- endform -%}
{%- endcapture -%}

{{ 'nl-password.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nl-password.js' | asset_url }}" defer></script>

<nl-password
  class="{{ classes }}{% if staff_failed %} is-staff{% endif %}"
  style="--nl-password-text: {{ section.settings.color_text }}; --nl-password-line: {{ section.settings.color_line }}; --nl-password-highlight: {{ section.settings.color_highlight }};"
  data-success="{{ section.settings.success_message | escape }}"
>
  <button type="button" class="nl-password__staff-hotspot" aria-hidden="true" tabindex="-1" data-staff-open></button>

  <div class="nl-password__staff">
    {{ staff_form }}
  </div>

  <div class="nl-password__page">
    <div class="nl-password__stage{% if section.settings.image != blank %} nl-password__stage--image{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="nl-password__image">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(max-width: 1024px) and (orientation: portrait) 80vw, 45vw',
              widths: '400, 600, 800, 1000, 1200',
              alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="nl-password__info">
        <div class="nl-password__logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 1200 | image_tag: alt: shop.name }}
          {%- else -%}
            <span class="nl-password__shop-name">{{ shop.name | escape }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.tag_text != blank -%}
          <div class="nl-password__tag">
            {%- if section.settings.tag_ornaments -%}
              <div class="nl-password__tag-rule" aria-hidden="true"></div>
              <div class="nl-password__dots" aria-hidden="true">
                <div class="nl-password__dot"></div>
                <div class="nl-password__dot"></div>
                <div class="nl-password__dot"></div>
              </div>
            {%- endif -%}
            <div class="nl-password__tag-text">{{ section.settings.tag_text | escape }}</div>
            {%- if section.settings.tag_ornaments -%}
              <div class="nl-password__dots" aria-hidden="true">
                <div class="nl-password__dot"></div>
                <div class="nl-password__dot"></div>
                <div class="nl-password__dot"></div>
              </div>
              <div class="nl-password__tag-rule" aria-hidden="true"></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.line_1 != blank or section.settings.line_2 != blank or section.settings.line_3 != blank or section.settings.sub_line != blank -%}
          <div class="nl-password__lines">
            {%- if section.settings.line_1 != blank -%}<p>{{ section.settings.line_1 | escape }}</p>{%- endif -%}
            {%- if section.settings.line_2 != blank -%}<p>{{ section.settings.line_2 | escape }}</p>{%- endif -%}
            {%- if section.settings.line_3 != blank -%}<p>{{ section.settings.line_3 | escape }}</p>{%- endif -%}
            {%- if section.settings.sub_line != blank -%}<p class="nl-password__subline">{{ section.settings.sub_line | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_signup -%}
          <div class="nl-password__signup">
            {%- form 'customer', id: 'NlPasswordSignup', class: 'nl-password__form' -%}
              <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tag | escape }}">
              <input type="hidden" name="return_to" value="{{ request.path }}">
              {%- if form.posted_successfully? -%}
                <p class="nl-password__message" role="status">{{ section.settings.success_message | escape }}</p>
              {%- else -%}
                <input
                  type="email"
                  name="contact[email]"
                  id="NlPasswordSignup-email"
                  placeholder="{{ section.settings.email_placeholder | escape }}"
                  aria-label="{{ section.settings.email_placeholder | escape }}"
                  autocomplete="email"
                  required
                >
                <button type="submit">{{ section.settings.button_label | escape }}</button>
                {%- if form.errors -%}
                  <p class="nl-password__message" role="alert">{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</nl-password>

{% schema %}
{
  "name": "Password page",
  "class": "nl-password-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "header", "content": "Media" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. One frame of the product with plenty of negative space. Leave empty to show the logo and copy only."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to show the store name as text."
    },
    { "type": "header", "content": "Tag" },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag text",
      "default": "LINE 01",
      "info": "Leave empty to hide the tag."
    },
    {
      "type": "checkbox",
      "id": "tag_ornaments",
      "label": "Show rules and dots around the tag",
      "default": true
    },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "line_1", "label": "Line 1" },
    { "type": "text", "id": "line_2", "label": "Line 2" },
    { "type": "text", "id": "line_3", "label": "Line 3", "default": "First access, Nov 15." },
    {
      "type": "text",
      "id": "sub_line",
      "label": "Sub-line",
      "info": "Smaller, muted line under the copy, in the serif font. Wraps onto two lines on phones.",
      "default": "The list receives the passcode two days before the public. 50 units. No restock."
    },
    { "type": "header", "content": "Signup" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request access" },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse around the button",
      "default": true,
      "info": "Always off for visitors who prefer reduced motion."
    },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're on the list." },
    {
      "type": "text",
      "id": "customer_tag",
      "label": "Customer tag",
      "default": "holding-page",
      "info": "Added to everyone who signs up here, so you can find them in Customers."
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#3A3A3A" },
    { "type": "color", "id": "color_line", "label": "Rules, dots and underline", "default": "#2A2A2A" },
    { "type": "color", "id": "color_highlight", "label": "Animation highlight", "default": "#5A5A5A" },
    {
      "type": "paragraph",
      "content": "Background, button and font come from Theme settings (Colors, Typography)."
    },
    { "type": "header", "content": "Staff login" },
    {
      "type": "paragraph",
      "content": "Staff open the store password form through an invisible hotspot in the top-left corner."
    },
    { "type": "text", "id": "staff_placeholder", "label": "Password placeholder", "default": "Store password" },
    { "type": "text", "id": "staff_button", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "staff_error", "label": "Error message", "default": "Incorrect password." }
  ]
}
{% endschema %}
