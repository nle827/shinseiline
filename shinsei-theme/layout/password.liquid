<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_img_url: 'icon' }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_img_url: 'compact' }}">

    {{ content_for_header }}
  </head>

  <style>
    /* Hide Shopify password challenge form - show custom password page */
    .shopify-challenge {
      display: none !important;
    }
    
    .shopify-challenge__container,
    .shopify-challenge__form,
    .shopify-challenge__button,
    .shopify-challenge__header {
      display: none !important;
    }

    body {
      background-color: #FAFAFA !important;
    }

    /* Ensure our custom wrapper displays */
    .password-page-wrapper {
      display: flex !important;
    }
  </style>

  <body>
    {{ content_for_layout }}
  </body>
</html>
