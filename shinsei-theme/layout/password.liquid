<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Design tokens (Theme settings) %}
    {% render 'nl-tokens' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_img_url: 'icon' }}" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_img_url: 'compact' }}">

    {{ content_for_header }}
  </head>

  <style>
    /* Hide Shopify's own password challenge; the nl-password section
       (assets/nl-password.css) provides the page */
    .shopify-challenge,
    .shopify-challenge__container,
    .shopify-challenge__form,
    .shopify-challenge__button,
    .shopify-challenge__header {
      display: none !important;
    }

    body {
      background-color: var(--nl-color-bg, #fafafa) !important;
    }
  </style>

  <body>
    {{ content_for_layout }}
  </body>
</html>
