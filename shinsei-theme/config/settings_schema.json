[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "LINE 01 drop",
    "settings": [
      {
        "type": "header",
        "content": "Drop window"
      },
      {
        "type": "paragraph",
        "content": "Timestamps are UTC (e.g. 2026-11-15T17:00:00Z = 9:00am PT while PST is in effect)."
      },
      {
        "type": "text",
        "id": "drop_early_access_start",
        "label": "Early access start (UTC)",
        "default": "2026-11-15T17:00:00Z"
      },
      {
        "type": "text",
        "id": "drop_public_open",
        "label": "Public open (UTC)",
        "default": "2026-11-17T17:00:00Z"
      },
      {
        "type": "text",
        "id": "drop_close",
        "label": "Drop close (UTC)",
        "default": "2026-11-24T17:00:00Z"
      },
      {
        "type": "header",
        "content": "Passcode"
      },
      {
        "type": "text",
        "id": "drop_passcode_hash",
        "label": "Passcode hash (SHA-256, lowercase hex)",
        "info": "Never enter the plain passcode here — only its SHA-256 hash. See the theme's drop-gating notes for the command to generate it."
      },
      {
        "type": "header",
        "content": "Testing"
      },
      {
        "type": "select",
        "id": "drop_phase_override",
        "label": "Phase override",
        "info": "For testing on an unpublished theme only. Leave on Auto in production.",
        "options": [
          { "value": "auto", "label": "Auto (use dates above)" },
          { "value": "pre", "label": "Force: Pre" },
          { "value": "early", "label": "Force: Early access" },
          { "value": "public", "label": "Force: Public" },
          { "value": "closed", "label": "Force: Closed" }
        ],
        "default": "auto"
      }
    ]
  }
]
