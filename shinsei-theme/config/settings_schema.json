[
  {
    "name": "theme_info",
    "theme_name": "Shinsei Line",
    "theme_version": "1.0.0",
    "theme_author": "Nathan Le",
    "theme_documentation_url": "https://github.com/nle827/shinseiline",
    "theme_support_url": "https://theshinseiline.com/pages/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Design tokens. Every section and nl- module reads these as CSS variables (--nl-color-*)."
      },
      { "type": "header", "content": "Surfaces" },
      { "type": "color", "id": "nl_color_bg", "label": "Page background", "default": "#FAFAFA" },
      { "type": "color", "id": "nl_color_bg_alt", "label": "Section background", "default": "#F5F5F5" },
      { "type": "color", "id": "nl_color_white", "label": "Fields and light-on-dark", "default": "#FFFFFF" },
      { "type": "color", "id": "nl_color_placeholder", "label": "Image placeholder", "default": "#F0F0F0" },
      { "type": "color", "id": "nl_color_card", "label": "Product card background", "default": "#E8E8E8" },
      { "type": "header", "content": "Text" },
      { "type": "color", "id": "nl_color_text", "label": "Primary text", "default": "#0D0D0D" },
      { "type": "color", "id": "nl_color_ink", "label": "Ink (buttons, active UI, dark surfaces)", "default": "#111111" },
      { "type": "color", "id": "nl_color_text_mid", "label": "Body copy, muted", "default": "#555555" },
      { "type": "color", "id": "nl_color_text_secondary", "label": "Secondary text", "default": "#6A6A6A" },
      { "type": "color", "id": "nl_color_text_light", "label": "Labels and eyebrows", "default": "#999999" },
      { "type": "color", "id": "nl_color_text_ghost", "label": "Faintest labels and placeholders", "default": "#AAAAAA" },
      { "type": "color", "id": "nl_color_on_dark", "label": "Text on dark surfaces", "default": "#E8E6E1" },
      { "type": "header", "content": "Lines and accents" },
      { "type": "color", "id": "nl_color_rule", "label": "Dividers", "default": "#D8D8D8" },
      { "type": "color", "id": "nl_color_border", "label": "Borders", "default": "#E2E2E2" },
      { "type": "color", "id": "nl_color_accent", "label": "Accent", "default": "#1A1A2E" },
      { "type": "color", "id": "nl_color_error", "label": "Error", "default": "#C0392B" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "text",
        "id": "nl_font_sans",
        "label": "Sans-serif stack (UI, labels, body)",
        "default": "'Helvetica Neue', Helvetica, Arial, sans-serif",
        "info": "A CSS font stack. Helvetica Neue isn't in Shopify's font library, so it's set here as system fonts."
      },
      {
        "type": "font_picker",
        "id": "nl_font_serif",
        "label": "Serif (display, product names)",
        "default": "ebgaramond_n4"
      },
      {
        "type": "font_picker",
        "id": "nl_font_nav",
        "label": "Navigation",
        "default": "raleway_n6"
      }
    ]
  },
  {
    "name": "Layout and spacing",
    "settings": [
      { "type": "range", "id": "nl_page_width", "label": "Max content width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
      { "type": "range", "id": "nl_text_width", "label": "Max text width", "min": 480, "max": 880, "step": 10, "unit": "px", "default": 680 },
      { "type": "header", "content": "Spacing scale" },
      { "type": "range", "id": "nl_space_xs", "label": "Extra small", "min": 4, "max": 16, "step": 1, "unit": "px", "default": 8 },
      { "type": "range", "id": "nl_space_sm", "label": "Small", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 16 },
      { "type": "range", "id": "nl_space_md", "label": "Medium", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 32 },
      { "type": "range", "id": "nl_space_lg", "label": "Large", "min": 32, "max": 128, "step": 4, "unit": "px", "default": 64 },
      { "type": "range", "id": "nl_space_xl", "label": "Extra large", "min": 60, "max": 200, "step": 4, "unit": "px", "default": 120 }
    ]
  },
  {
    "name": "LINE 01 drop",
    "settings": [
      {
        "type": "header",
        "content": "Drop window"
      },
      {
        "type": "paragraph",
        "content": "Timestamps are UTC (e.g. 2026-11-15T17:00:00Z = 9:00am PT while PST is in effect)."
      },
      {
        "type": "text",
        "id": "drop_early_access_start",
        "label": "Early access start (UTC)",
        "default": "2026-11-15T17:00:00Z"
      },
      {
        "type": "text",
        "id": "drop_public_open",
        "label": "Public open (UTC)",
        "default": "2026-11-17T17:00:00Z"
      },
      {
        "type": "text",
        "id": "drop_close",
        "label": "Drop close (UTC)",
        "default": "2026-11-24T17:00:00Z"
      },
      {
        "type": "header",
        "content": "Passcode"
      },
      {
        "type": "text",
        "id": "drop_passcode_hash",
        "label": "Passcode hash (SHA-256, lowercase hex)",
        "info": "Never enter the plain passcode here — only its SHA-256 hash. See the theme's drop-gating notes for the command to generate it."
      },
      {
        "type": "header",
        "content": "Testing"
      },
      {
        "type": "select",
        "id": "drop_phase_override",
        "label": "Phase override",
        "info": "For testing on an unpublished theme only. Leave on Auto in production.",
        "options": [
          { "value": "auto", "label": "Auto (use dates above)" },
          { "value": "pre", "label": "Force: Pre" },
          { "value": "early", "label": "Force: Early access" },
          { "value": "public", "label": "Force: Public" },
          { "value": "closed", "label": "Force: Closed" }
        ],
        "default": "auto"
      }
    ]
  }
]
